rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validMeasurement() {
      let entry = request.resource.data;
      return entry.value is number && entry.value > 0 && entry.value <= 1.7976931348623157e308
        && entry.measuredAt is timestamp
        && entry.kind == 'weight'
        && (!('unit' in entry) || entry.unit in ['kg', 'lb']);
    }

    match /users/{uid} {
      allow read, create, update: if owns(uid);

      match /measurements/{id} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid) && validMeasurement();
      }
    }
  }
}
